<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Service Feedback with Star Rating</title>
    <style>
        :root { 
            --primary: #2563eb;
            --primary-light: #eff6ff;
            --text-main: #1e293b;
            --text-sub: #64748b;
            --bg-body: #f1f5f9;
            --border: #e2e8f0;
            --star-color: #f59e0b; /* 星星黃色 */
            --star-empty: #cbd5e1; /* 空星灰色 */
        }/* 定義變數 */

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        } /* 字體 */

        .survey-card {
            max-width: 800px;
            margin: 0 auto; /* 置中 */
            background: #ffffff;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        } /* 白色框框 */

        .header {
            text-align: left;
            border-bottom: 2px solid var(--bg-body);
            margin-bottom: 30px;
            padding-bottom: 20px;
        } /* 標題下的淺色橫線 */

        .header h1 { font-size: 24px; margin: 0; color: var(--text-main); }
        .header p { color: var(--text-sub); margin: 8px 0 0; }

        .section-label {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--primary);
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            margin-top: 30px;
        } /* 每個區塊的小標題 */   
        
        .section-label::after {
            content: "";
            flex: 1;
            height: 1px;
            background: var(--border);
            margin-left: 10px;
        } /* 藍字後面的線 */ 
        
        /* 網格佈局 */
        .grid-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group { margin-bottom: 25px; }
        
        label.main-label {
            display: block;
            margin-bottom: 12px;
            font-weight: 600;
            font-size: 15px;
        }

        input[type="text"], 
        input[type="email"], 
        input[type="tel"], 
        textarea {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--border);
            border-radius: 8px;
            box-sizing: border-box;
            font-size: 15px;
            transition: all 0.2s ease;
        } /* 輸入框的寬度、內距和圓角。 */

        input:focus, textarea:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        /* --- 星星評分樣式 (CSS Only) --- */
        .star-rating {
            display: flex;
            flex-direction: row-reverse; /* 重要：為了讓 Hover 邏輯正確工作 */
            justify-content: flex-end;
            gap: 5px;
            margin-top: 5px;
        }

        .star-rating input {
            display: none; /* 隱藏傳統的單選鈕 */
        }

        .star-rating label {
            font-size: 32px; /* 星星大小 */
            color: var(--star-empty); /* 預設空星顏色 */
            cursor: pointer;
            transition: color 0.2s ease;
        }

        /* 當滑鼠懸停在星星上時，以及該星星之前的所有星星 (因為 row-reverse) */
        .star-rating label:hover,
        .star-rating label:hover ~ label {
            color: var(--star-color);
        }

        /* 當某個星星被選取時，以及該星星之前的所有星星 */
        .star-rating input:checked ~ label {
            color: var(--star-color);
        }

        /* 當星星被選取後，滑鼠懸停在星星上時，保持星星顏色 */
        .star-rating input:checked + label:hover,
        .star-rating input:checked ~ label:hover,
        .star-rating label:hover ~ input:checked ~ label,
        .star-rating input:checked ~ label:hover ~ label {
            color: var(--star-color);
        }

        /* --- 是否想再來 - 切換按鈕樣式 (沿用) --- */
        .choice-toggle {
            display: flex;
            gap: 12px;
        }

        .choice-item { flex: 1; position: relative; }

        .choice-item input {
            position: absolute;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }

        .choice-label {
            display: block;
            text-align: center;
            padding: 14px;
            border: 2px solid var(--border);
            border-radius: 10px;
            font-weight: 600;
            color: var(--text-sub);
            transition: all 0.2s;
        }

        .choice-item input:checked + .choice-label {
            border-color: var(--primary);
            background-color: var(--primary-light);
            color: var(--primary);
        }

        /* 提交按鈕 */
        .submit-btn {
            background-color: var(--primary);
            color: white;
            border: none;
            padding: 16px 32px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 700;
            width: 100%;
            cursor: pointer;
            margin-top: 20px;
            transition: background 0.2s, transform 0.1s;
        }

        .submit-btn:hover { background-color: #1d4ed8; }
        .submit-btn:active { transform: scale(0.98); }

        /* 響應式調整 */
        @media (max-width: 480px) {
            .survey-card { padding: 25px 20px; }
            .grid-row { grid-template-columns: 1fr; }
            .choice-toggle { flex-direction: column; }
            .star-rating label { font-size: 28px; }
        }
    </style>
</head>

<body> <!--網頁內容-->

<div class="survey-card">
    <div class="header">
        <h1>Experience Feedback</h1>
        <p>Your insights help us provide better service for you.</p>
    </div>

    <form action="#" method="POST">
        
        <div class="section-label">Contact Details</div>
        <div class="grid-row">
            <div class="form-group">
                <label class="main-label" for="full-name">Full Name</label>
                <input type="text" id="full-name" name="name" placeholder="John Doe" required> <!--required 代表沒填寫就不能送出-->
            </div>
            <div class="form-group">
                <label class="main-label" for="phone">Phone Number</label>
                <input type="tel" id="phone" name="phone" placeholder="+1 (234) 567-890" required>
            </div>
        </div>
        <div class="form-group">
            <label class="main-label" for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="example@mail.com">
        </div>

        <div class="section-label">Service Quality</div>
        
        <div class="form-group">
            <label class="main-label">1. Overall Service Speed</label>
            <div class="star-rating">
                <input type="radio" id="speed-5" name="speed" value="5" required><label for="speed-5">&#9733;</label>
                <input type="radio" id="speed-4" name="speed" value="4"><label for="speed-4">&#9733;</label>
                <input type="radio" id="speed-3" name="speed" value="3"><label for="speed-3">&#9733;</label>
                <input type="radio" id="speed-2" name="speed" value="2"><label for="speed-2">&#9733;</label>
                <input type="radio" id="speed-1" name="speed" value="1"><label for="speed-1">&#9733;</label>
            </div>
        </div>

        <div class="form-group">
            <label class="main-label">2. Staff Professionalism</label>
            <div class="star-rating">
                <input type="radio" id="staff-5" name="staff" value="5" required><label for="staff-5">&#9733;</label>
                <input type="radio" id="staff-4" name="staff" value="4"><label for="staff-4">&#9733;</label>
                <input type="radio" id="staff-3" name="staff" value="3"><label for="staff-3">&#9733;</label>
                <input type="radio" id="staff-2" name="staff" value="2"><label for="staff-2">&#9733;</label>
                <input type="radio" id="staff-1" name="staff" value="1"><label for="staff-1">&#9733;</label>
            </div>
        </div>

        <div class="form-group">
            <label class="main-label">3. Cleanliness & Environment</label>
            <div class="star-rating">
                <input type="radio" id="clean-5" name="clean" value="5" required><label for="clean-5">&#9733;</label>
                <input type="radio" id="clean-4" name="clean" value="4"><label for="clean-4">&#9733;</label>
                <input type="radio" id="clean-3" name="clean" value="3"><label for="clean-3">&#9733;</label>
                <input type="radio" id="clean-2" name="clean" value="2"><label for="clean-2">&#9733;</label>
                <input type="radio" id="clean-1" name="clean" value="1"><label for="clean-1">&#9733;</label>
            </div>
        </div>

        <div class="section-label">Future Intent</div>
        <div class="form-group">
            <label class="main-label">Would you like to return to us or use our service again?</label>
            <div class="choice-toggle">
                <div class="choice-item">
                    <input type="radio" id="return-yes" name="return_visit" value="yes" required>
                    <label for="return-yes" class="choice-label">Yes, Definitely</label>
                </div>
                <div class="choice-item">
                    <input type="radio" id="return-no" name="return_visit" value="no">
                    <label for="return-no" class="choice-label">No, Not really</label>
                </div>
                <div class="choice-item">
                    <input type="radio" id="return-maybe" name="return_visit" value="maybe">
                    <label for="return-maybe" class="choice-label">Maybe</label>
                </div>
            </div>
        </div>

        <div class="section-label">Final Thoughts</div>
        <div class="form-group">
            <label class="main-label" for="feedback">Anything else we should know?</label>
            <textarea id="feedback" name="feedback" rows="4" placeholder="Share your suggestions here..."></textarea>
        </div>

        <button type="submit" class="submit-btn">Submit Feedback</button> <!--使用者點擊這個按鈕後，會觸發瀏覽器檢查有沒有漏填，然後送出表單-->
    </form>
</div>

</body>
</html>
