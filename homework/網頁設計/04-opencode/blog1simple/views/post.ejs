<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= post.title %> - Simple Blog</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <h1><a href="/">Simple Blog</a></h1>
    <nav>
      <a href="/" class="btn">Back</a>
      <a href="/post/new" class="btn">New Post</a>
    </nav>
  </header>
  <main>
    <article class="post-full">
      <h2><%= post.title %></h2>
      <p class="date"><%= new Date(post.created_at).toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
      <div class="content"><%= post.content %></div>
      <form action="/post/<%= post.id %>/delete" method="POST" class="delete-form">
        <button type="submit" class="btn btn-danger" onclick="return confirm('Delete this post?')">Delete</button>
      </form>
    </article>
  </main>
</body>
</html>
